# Loopwright runs with none of these set: the built-in scripted model needs no key.

# ---- model: pick one (or leave all unset and let `auto` choose)
# LOOPWRIGHT_PROVIDER=scripted          # scripted | local | claude-code | anthropic | openai
# LOOPWRIGHT_LOCAL_URL=                 # a local model server other than Ollama/LM Studio/llama.cpp defaults
# LOOPWRIGHT_MODEL=                     # empty = the provider's default
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=                       # any non-empty value for a local server
# OPENAI_BASE_URL=http://localhost:11434/v1
# LOOPWRIGHT_FALLBACK=anthropic:claude-haiku-5-5    # provider:model tried when the first one fails

# ---- web search: auto picks tavily, then brave, then keyless duckduckgo
# LOOPWRIGHT_SEARCH=                    # tavily | brave | claude-code | duckduckgo | demo
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ---- where state lives (default ~/.loopwright)
# LOOPWRIGHT_HOME=

# ---- any field of Options can be set as LOOPWRIGHT_<FIELD>, for example:
# LOOPWRIGHT_GATE=model
# LOOPWRIGHT_APPROVALS=ask

# ---- chat gateways (docs/gateways.md). Each needs a token and an allowlist of who may talk to the agent.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED=                     # chat ids, comma or space separated
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED=                      # user ids
# SLACK_APP_TOKEN=                      # xapp-... (Socket Mode)
# SLACK_BOT_TOKEN=                      # xoxb-...
# SLACK_ALLOWED=                        # member ids
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ALLOWED=                     # phone numbers, digits only

# ---- the browser agent: only if Chrome/Chromium/Edge/Brave is not found automatically
# LOOPWRIGHT_CHROME=/path/to/chrome

# ---- send every turn's trace to an OpenTelemetry collector (OTLP over HTTP)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...
