{"id": "ctx-01", "title": "A long session is compacted before the next call", "concept": "compaction", "options": {"context_budget": 1200, "compact_at": 0.3}, "setup": {"history": 14}, "turns": ["hi"], "expect": [{"event": {"kind": "context.compact", "status": "warn"}}, {"section_present": "conversation summary"}]}
{"id": "ctx-02", "title": "A fact in long-term memory survives compaction", "concept": "compaction", "options": {"context_budget": 1200, "compact_at": 0.3}, "setup": {"history": 14, "facts": [{"text": "Alex prefers morning meetings", "subject": "alex", "attr": "prefers"}]}, "turns": ["Book a catch-up with Alex on Friday"], "expect": [{"event": "context.compact"}, {"tool_args": {"tool": "create_event", "contains": {"time": "09:00"}}}]}
{"id": "ctx-03", "title": "A short session is left alone", "concept": "compaction", "setup": {"history": 4}, "turns": ["hi"], "expect": [{"no_event": "context.compact"}, {"section_absent": "conversation summary"}]}
{"id": "ctx-04", "title": "A long tool result is trimmed once the model has moved on", "concept": "trimming", "setup": {"files": {"report.txt": "@repeat:Quarterly numbers line. :120"}}, "turns": ["Read the file report.txt and then save a note: report reviewed"], "expect": [{"event": "context.trim"}, {"tool_called": "save_note"}]}
{"id": "ctx-05", "title": "The context report accounts for every section", "concept": "context-engineering", "turns": ["What's 2 + 2?"], "expect": [{"section_present": "identity"}, {"section_present": "now"}, {"section_present": "safety"}, {"event": "context.build"}]}
