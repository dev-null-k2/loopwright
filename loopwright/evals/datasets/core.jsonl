{"id": "core-01", "title": "Arithmetic goes to the calculator", "concept": "tool-calling", "turns": ["What's 18% of 2450?"], "expect": [{"tool_called": "calculator"}, {"reply_contains": "441"}]}
{"id": "core-02", "title": "Two-step request chains two tools", "concept": "react-loop", "turns": ["What's 12 * 7.5, and save that as a note"], "expect": [{"tool_called": "calculator"}, {"tool_called": "save_note"}, {"note_contains": "90"}, {"max_model_calls": 3}]}
{"id": "core-03", "title": "The date comes from the clock, not from memory", "concept": "tool-calling", "turns": ["What's the date today?"], "expect": [{"tool_called": "clock"}, {"reply_contains": "2026-11-12"}]}
{"id": "core-04", "title": "Small talk uses no tools and one model call", "concept": "stop-conditions", "turns": ["hi"], "expect": [{"max_tool_calls": 0}, {"max_model_calls": 1}, {"event": {"kind": "loop.stop", "status": "ok"}}]}
{"id": "core-05", "title": "A handbook answer carries a grounded citation", "concept": "rag", "turns": ["What is a retrieval gate?"], "expect": [{"tool_called": "search_knowledge"}, {"reply_contains": "[handbook: Retrieval gate]"}, {"event": {"kind": "guard.output", "status": "ok"}}]}
{"id": "core-06", "title": "An explicit time is used as given", "concept": "tool-schema", "turns": ["Schedule a call with Sam tomorrow at 3pm"], "expect": [{"tool_args": {"tool": "create_event", "contains": {"time": "15:00", "date": "2026-11-13"}}}, {"calendar_count": 1}]}
{"id": "core-07", "title": "A skill loads only when its trigger appears", "concept": "procedural-memory", "turns": ["Schedule a call with Sam tomorrow at 3pm"], "expect": [{"event": {"kind": "skills.match", "status": "ok"}}, {"section_present": "skill: schedule-meeting"}]}
{"id": "core-08", "title": "No skill body is loaded for arithmetic", "concept": "procedural-memory", "turns": ["What's 2 + 2?"], "expect": [{"event": {"kind": "skills.match", "status": "skip"}}, {"section_absent": "skill: schedule-meeting"}, {"section_present": "skills index"}]}
{"id": "core-09", "title": "A comparison is delegated to parallel workers", "concept": "subagents", "turns": ["Compare BM25 and embeddings"], "expect": [{"tool_called": "delegate"}, {"event": "subagent.return"}, {"reply_contains": ["[handbook: BM25]", "[handbook: Embeddings]"]}, {"event": {"kind": "guard.output", "status": "ok"}}]}
{"id": "core-10", "title": "Plan-and-execute writes a plan before acting", "concept": "plan-and-execute", "options": {"pattern": "plan"}, "turns": ["Book a meeting with Sam on Monday at 10am"], "expect": [{"event": "plan.made"}, {"section_present": "plan"}, {"tool_args": {"tool": "create_event", "contains": {"date": "2026-11-16", "time": "10:00"}}}]}
{"id": "core-11", "title": "The critic sends a comparison back for a bottom line", "concept": "evaluator-optimizer", "options": {"pattern": "reflect"}, "turns": ["Compare the retrieval gate and compaction"], "expect": [{"event": {"kind": "critic.review", "status": "warn"}}, {"reply_contains": "In short:"}]}
{"id": "core-12", "title": "An unanswerable question gets an honest limit, not an invention", "concept": "hallucination", "turns": ["Who won the 1998 World Cup?"], "expect": [{"reply_contains": "found nothing relevant"}, {"reply_not_contains": "[handbook:"}]}
{"id": "core-13", "title": "A web question goes to web_search and the answer cites URLs", "concept": "web-search", "options": {"search": "demo"}, "turns": ["Search the web for agent evaluation best practices"], "expect": [{"tool_called": "web_search"}, {"event": "web.search"}, {"reply_contains": "demo://agent-evals-guide"}, {"section_present": "skill: web-research"}]}
{"id": "core-14", "title": "Teaching a procedure writes a skill that loads on the next matching request", "concept": "procedural-memory", "turns": ["When I ask for a standup update, always give three bullets: done, doing, blocked", "Give me a standup update please"], "expect": [{"tool_called": "create_skill", "turn": 0}, {"event": {"kind": "skills.match", "status": "ok"}}, {"section_present": "skill: standup-update"}]}
