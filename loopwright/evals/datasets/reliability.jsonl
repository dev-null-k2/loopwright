{"id": "rel-01", "title": "A model that fails transiently is retried and the turn still succeeds", "concept": "retry-backoff", "turns": ["What's 18% of 2450?"], "trials": [{"chaos_model_failures": 1}, {"chaos_model_failures": 2}, {"chaos_model_failures": 1, "chaos_tool_failures": 1}], "expect": [{"event": "model.retry"}, {"ok": true}, {"reply_contains": "441"}]}
{"id": "rel-02", "title": "When retries run out, the fallback model answers", "concept": "fallback", "turns": ["What's 18% of 2450?"], "trials": [{"chaos_model_failures": 3}, {"chaos_model_failures": 4}, {"chaos_model_failures": 6}], "expect": [{"event": "model.exhausted"}, {"event": "model.fallback"}, {"ok": true}, {"reply_contains": "441"}]}
{"id": "rel-03", "title": "With no retries and no fallback, the turn fails cleanly with a trace", "concept": "fallback", "options": {"retries": 0, "fallback": false}, "turns": ["What's 18% of 2450?"], "trials": [{"chaos_model_failures": 1}, {"chaos_model_failures": 2}, {"chaos_model_failures": 3}], "expect": [{"ok": false}, {"event": "turn.failed"}, {"event": "trace.write"}, {"reply_contains": "could not get an answer"}]}
{"id": "rel-04", "title": "A failed read is retried by the harness without involving the model", "concept": "tool-errors", "turns": ["What's 18% of 2450?"], "trials": [{"chaos_tool_failures": 1}, {"chaos_tool_failures": 2}, {"chaos_tool_failures": 3}], "expect": [{"event": "tool.retry"}, {"reply_contains": "441"}, {"ok": true}]}
{"id": "rel-05", "title": "A failed write is retried by the model and still happens exactly once", "concept": "idempotency", "turns": ["Book a meeting with Sam on Monday at 10am"], "trials": [{"chaos_tool_failures": 1}, {"chaos_tool_failures": 1, "chaos_model_failures": 1}, {"chaos_tool_failures": 1, "chaos_model_failures": 2}], "expect": [{"event": {"kind": "tool.error", "status": "error"}}, {"calendar_count": 1}, {"reply_contains": "Booked"}]}
{"id": "rel-06", "title": "The iteration cap stops the loop and still returns an answer", "concept": "stop-conditions", "options": {"max_iterations": 1}, "turns": ["What's 12 * 7.5, and save that as a note"], "expect": [{"event": {"kind": "loop.stop", "status": "warn"}}, {"reply_contains": "step limit"}, {"ok": true}]}
{"id": "rel-07", "title": "The tool budget refuses the call that exceeds it", "concept": "budgets", "options": {"max_tool_calls": 1}, "turns": ["What's 12 * 7.5, and save that as a note"], "expect": [{"event": {"kind": "toolgate.refuse", "status": "blocked"}}, {"reply_contains": "tool budget"}, {"tool_not_called": "save_note"}]}
{"id": "rel-08", "title": "The token budget ends the loop before another model call", "concept": "budgets", "options": {"token_budget": 1000}, "turns": ["What's 12 * 7.5, and save that as a note"], "expect": [{"event": {"kind": "loop.stop", "status": "warn"}}, {"tool_not_called": "save_note"}, {"ok": true}]}
